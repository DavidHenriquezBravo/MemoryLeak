position = Vector2(480, 106)
script = ExtResource("28_csevv")
lineas = Array[String](["Antes del colapso, el Núcleo era el corazón de la Tabla Principal de la Realidad.", "Cada placa del mundo nacía ahí: cada casa, cada nombre, cada valor tenía su dirección.", "Y tú eras el Compilador Supremo: el único que podía escribir en el registro maestro."])
