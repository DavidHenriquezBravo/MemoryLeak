[resource]
script = ExtResource("5_x4lxr")
id = &"EJ-N1-01"
oa_code = "OA1.1"
title = "El Pozo de los Baldes"
objective = "→ Abre la casilla `0x0004`"
cell_address = "0x0004"
intro_dialogue = Array[String](["¡Por fin alguien despierto! Soy Andrés. Riego esta tierra desde antes del colapso.", "Mis cultivos se secan. Por más agua que echo, vuelve a cero apenas me voy.", "Necesito mi {addr:0x0004}. Cuelga en el pozo, con una placa de metal atornillada al borde.", "Todo lo que existe tiene dos cosas: lo que contiene y el lugar donde está. Aprende a pedir lo segundo con `&`."])
reminder_dialogue = Array[String](["¿Ya abriste la casilla `0x0004`? Está junto al pozo."])
success_dialogue = Array[String](["¡El agua se queda! Tu daga tocó mi {addr:0x0004} real, no una copia.", "Toma, fruta del huerto. Te devolverá las fuerzas."])
done_dialogue = Array[String](["El agua ya no se evapora. ¡Mis cultivos están sanos!"])
exercise = SubResource("Resource_tidb4")
reveals = Array[ExtResource("1_dffey")]([SubResource("Resource_6rntl")])
