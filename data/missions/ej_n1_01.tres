[sub_resource type="Resource" id="Resource_tidb4"]
script = ExtResource("4_6rnlh")
title = "CASILLA DE MEMORIA"
code = "int vida_aldeano = 30;"
question = "¿Qué representa `&vida_aldeano`?"
memory_cells = Array[ExtResource("1_dffey")]([SubResource("Resource_nf4fd")])
options = Array[ExtResource("2_0qmcd")]([SubResource("Resource_wcblk"), SubResource("Resource_5nhjh"), SubResource("Resource_vfnpe")])
conceptual_hint = "Todo tiene contenido (el 30) y lugar (su placa). `&` pide el lugar."
example_code = "int trigo = 5;
&trigo  →  0x0010"
example_cells = Array[ExtResource("1_dffey")]([SubResource("Resource_kape0")])
example_text = "`&trigo` no es 5: es la placa `0x0010`, el lugar donde vive el 5."
example_followup = "Mismo concepto, otra variable. Vuelve a tu casilla: ¿qué representa `&vida_aldeano`?"
success_title = "¡DIRECCIÓN OBTENIDA!"
success_text = "Tomaste la placa, no el balde. Eso hace `&`."
concept_text = "`&x` entrega la dirección de x, no su valor."
