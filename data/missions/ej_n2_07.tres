[sub_resource type="Resource" id="Resource_n209"]
script = ExtResource("4_ex")
title = "CASILLA DE MEMORIA"
code = "int x = 3;
int *p = &x;
x = 9;    // la anomalía
printf(\"%d\", *p);"
question = "¿Qué imprime `printf(\"%d\", *p);`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n205"), SubResource("Resource_n206")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "El puntero guarda dónde está `x`. Al leer `*p` se mira la casilla en ese momento, con lo que tenga ahora."
example_code = "int y = 2;
int *p = &y;
y = 15;
// *p vale 15"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n207"), SubResource("Resource_n208")])
example_text = "`p` se enlazó cuando `y` valía 2, pero `*p` lee la casilla ahora: 15."
example_followup = "Mismo concepto, otro espejo. Vuelve al de la Vidente: ¿qué imprime `*p`?"
success_title = "¡REFLEJO VERDADERO!"
success_text = "El puntero no congela un valor: sigue mirando la casilla, y la casilla cambió."
concept_text = "`*p` siempre lee el valor actual de la casilla apuntada."
reward = SubResource("Resource_n204")

