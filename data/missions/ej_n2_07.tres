[resource]
script = ExtResource("5_mision")
id = &"EJ-N2-07"
oa_code = "OA2.4"
title = "El Espejo de la Vidente"
objective = "→ Abre el espejo `0x0330`"
giver_name = "la Vidente"
cell_address = "0x0330"
intro_dialogue = Array[String](["Te esperaba. Soy la Vidente: guardo los espejos del distrito.", "Este espejo está enlazado a tu vida: `int x = 3; int *p = &x;`.", "Mira… una anomalía acaba de alterar tu estadística real. Ahora vale 9.", "Mi reloj apunta a ti; mírate ahora. El espejo descansa en {addr:0x0330}, junto a las setas."])
reminder_dialogue = Array[String](["El espejo `0x0330` sigue enlazado a ti. Mírate en él."])
success_dialogue = Array[String](["¿Lo ves? Mi espejo no guardó un retrato tuyo. Guardó dónde estás. Y tú cambiaste.", "Llévate un reflejo de suerte. A veces el destino también se lee a través de una placa."])
done_dialogue = Array[String](["El espejo sigue mirándote. Si cambias, él lo sabrá."])
exercise = SubResource("Resource_n209")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n210")])
