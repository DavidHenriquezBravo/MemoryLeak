[sub_resource type="Resource" id="Resource_n301"]
script = ExtResource("2_opt")
text = "Se liberaron automáticamente al reasignar `p`"
wrong_feedback = "Soltar la placa no devuelve el bloque. Solo pierde el camino hacia él."
concept_on_error = "En C, la memoria de `malloc` solo se devuelve con `free`."
hint = "¿Alguien llamó a `free`?"

[sub_resource type="Resource" id="Resource_n302"]
script = ExtResource("2_opt")
text = "Quedaron ocupados y sin forma de alcanzarlos: es una fuga de memoria"
is_correct = true

[sub_resource type="Resource" id="Resource_n303"]
script = ExtResource("2_opt")
text = "Se convirtieron en `NULL`"
wrong_feedback = "`NULL` es lo que guarda ahora la placa, no el bloque: el 42 sigue ahí, reservado."
concept_on_error = "`p = NULL` cambia el puntero, no la memoria a la que apuntaba."
hint = "¿Qué variable recibió el `NULL`: el bloque o la placa?"

