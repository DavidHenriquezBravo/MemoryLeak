[resource]
script = ExtResource("5_mision")
id = &"EJ-N2-03"
oa_code = "OA3.2"
title = "Los Gemelos Intercambiados"
objective = "→ Abre el yunque de Cast `0x0200`"
requires_mission = &"EJ-N2-02"
giver_name = "Cast y Ref"
cell_address = "0x0208"
cadena = Array[ExtResource("1_cell")]([SubResource("Resource_n201")])
intro_dialogue = Array[String](["¡Eh, tú! Somos Cast y Ref, los herreros gemelos. Bueno… ahora mismo no sé bien quién es quién.", "El Gran Segmentation Fault nos cambió la fuerza: yo tengo la de mi hermano y él la mía.", "Encontramos el ritual de intercambio en un pergamino, pero le falta la línea del medio.", "Cada yunque guarda la placa del otro. Empieza por el mío, {addr:0x0200}, junto a la forja roja.", "Guardamos el contenido del primer balde aparte. Ahora hay que verter el del segundo en el primero: contenido a contenido, no placa a placa."])
reminder_dialogue = Array[String](["Empieza por mi yunque, `0x0200`. Él te dirá dónde está el de mi hermano."])
success_dialogue = Array[String](["¡Mi brazo! ¡Vuelve a ser mío! Y Ref ya levanta su propio martillo.", "Ref te forjó algo: una mejora de armadura, de las buenas."])
done_dialogue = Array[String](["Cada uno con su fuerza. El ritual quedó completo gracias a ti."])
locked_dialogue = Array[String](["Estamos ocupados, forastero. Algo nos cruzó la fuerza y ningún martillo lo arregla.", "Dicen que el Notario sabe escribir oficios que tocan cosas de verdad. Habla con él primero."])
exercise = SubResource("Resource_n212")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n213")])
