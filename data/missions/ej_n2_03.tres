amount = 0.15

[sub_resource type="Resource" id="Resource_n212"]
script = ExtResource("4_ex")
title = "CASILLA DE MEMORIA"
code = "void swap(int *a, int *b) {
    int temp = *a;
    __________
    *b = temp;
}"
question = "¿Qué línea falta?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n206"), SubResource("Resource_n207"), SubResource("Resource_n208"), SubResource("Resource_n209")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n202"), SubResource("Resource_n203"), SubResource("Resource_n204")])
conceptual_hint = "`temp` ya guardó el contenido del primer yunque. Falta que el primer yunque reciba el contenido del segundo."
example_code = "void trocar(int *a, int *b) {
    int t = *b;
    *b = *a;
    *a = t;
}"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n210"), SubResource("Resource_n211")])
example_text = "Aquí se guarda primero `*b`. Por eso la línea del medio es `*b = *a`: contenido a contenido."
example_followup = "Mismo ritual, al revés. Vuelve al yunque de Ref: ¿qué línea falta en el swap?"
success_title = "¡FUERZAS DEVUELTAS!"
success_text = "El ritual vierte contenido a contenido: cada gemelo recupera su fuerza."
concept_text = "Para intercambiar a través de punteros se escribe en `*a` y `*b`, no en `a` y `b`."
reward = SubResource("Resource_n205")

