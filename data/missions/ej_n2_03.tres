[sub_resource type="Resource" id="Resource_n203"]
script = ExtResource("2_opt")
text = "`a = b;`"
wrong_feedback = "Cruzaste las placas dentro de la función, pero los baldes de afuera siguen igual. Al salir, las placas se pierden."
concept_on_error = "Asignar punteros cambia adónde miran, no lo que hay en las casillas."
hint = "Los gemelos siguen cambiados. Moviste las placas; hay que mover lo que hay detrás de ellas."

[sub_resource type="Resource" id="Resource_n204"]
script = ExtResource("2_opt")
text = "`&a = &b;`"
wrong_feedback = "El pergamino se prende en llamas rojas: la dirección de una variable no se puede reasignar."
concept_on_error = "`&a` no es una casilla donde escribir: no puede ir a la izquierda del `=`."
hint = "Esa línea ni siquiera compila. Piensa en verter contenido, no en mover placas."

[sub_resource type="Resource" id="Resource_n205"]
