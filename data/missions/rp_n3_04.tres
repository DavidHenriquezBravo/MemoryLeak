success_text = "Lo que fallaste en el Núcleo ahora cuenta como acierto."
concept_text = "Un arreglo de punteros guarda direcciones, no los textos."

[resource]
script = ExtResource("5_mision")
id = &"RP-N3-04"
oa_code = "OA3.4"
title = "Repaso: El Censo de Nullville"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano, en la entrada del volcán"
variante_de = &"EJ-N3-04"
intro_dialogue = Array[String](["Antes de entrar al Núcleo, quiero estar seguro de algo.", "Fallaste algunas pruebas en la ciudad. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «El Censo de Nullville». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «El Censo de Nullville»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n314")
