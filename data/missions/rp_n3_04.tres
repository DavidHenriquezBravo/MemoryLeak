    \"Nullville\",
    \"Nucleo\"
};"
question = "¿Qué es `lugares[0]`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n304"), SubResource("Resource_n305"), SubResource("Resource_n306"), SubResource("Resource_n307")])
