[sub_resource type="Resource" id="Resource_n213"]
script = ExtResource("4_ex")
title = "CASILLA DE MEMORIA"
code = "int mana = 5;
int *p = &mana, *q = &mana;
*p = 20;
printf(\"%d %d\", mana, *q);"
question = "¿Qué imprime el fragmento?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n207"), SubResource("Resource_n208"), SubResource("Resource_n209")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n203"), SubResource("Resource_n204"), SubResource("Resource_n205")])
conceptual_hint = "`p` y `q` guardan la misma placa. Lo que se escriba con uno se lee igual con el otro."
example_code = "int oro = 3;
int *r = &oro, *s = &oro;
*s = 12;
// *r vale 12"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n210"), SubResource("Resource_n211"), SubResource("Resource_n212")])
example_text = "`r` y `s` apuntan a `oro`. `*s = 12` cambia `oro`, así que `*r` también vale 12."
example_followup = "Mismo concepto, otro cofre. Vuelve con los libros de Sara: ¿qué imprime el fragmento?"
success_title = "¡ALIASING DESCUBIERTO!"
success_text = "Dos dagas, un solo balde. Sara reorganiza su archivo."
concept_text = "Aliasing: dos punteros a la misma casilla ven y cambian el mismo dato."
reward = SubResource("Resource_n206")

