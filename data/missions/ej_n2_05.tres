[resource]
script = ExtResource("5_mision")
id = &"EJ-N2-05"
oa_code = "OA3.3"
title = "Los Dos Libros de Sara"
objective = "→ Revisa los dos montones de libros: `0x0150` y `0x0158`"
giver_name = "Sara"
cell_address = "0x0160"
cadena = Array[ExtResource("1_cell")]([SubResource("Resource_n201"), SubResource("Resource_n202")])
intro_dialogue = Array[String](["Tengo otro misterio, y me da vergüenza contarlo.", "Llevo dos libros separados del maná. Juro que los actualizo por separado… pero cada vez que corrijo uno, el otro cambia solo.", "Creí tener dos registros. Tengo dos placas… con la misma dirección grabada, creo.", "Revisa los dos: {addr:0x0150} es el montón junto a la entrada y {addr:0x0158} el que está al lado de los estantes de la derecha."])
reminder_dialogue = Array[String](["Revisa mis dos montones de libros, `0x0150` y `0x0158`. Quiero saber adónde apunta cada uno."])
success_dialogue = Array[String](["Dos placas, un solo cofre. Con razón uno cambiaba al tocar el otro.", "Voy a reorganizar todo mi archivo. Toma este trébol de cuarzo: dicen que trae suerte."])
done_dialogue = Array[String](["Ahora sé que mis dos libros miran el mismo cofre. Ya no me asustan."])
exercise = SubResource("Resource_n213")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n214")])
