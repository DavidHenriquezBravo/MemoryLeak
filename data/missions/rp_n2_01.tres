[sub_resource type="Resource" id="Resource_n208"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "void abonar(int saldo) {
    saldo += 100;
}
int caja = 0;
abonar(caja);
printf(\"%d\", caja);"
question = "¿Qué imprime `caja`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n204"), SubResource("Resource_n205")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "La función trabaja con una copia de `caja`. Lo que cambie en ella se pierde al terminar."
example_code = "void abonar(int fondo) {
    fondo = fondo + 10;
}
int caja = 0;
abonar(caja);   // imprime 0"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n206"), SubResource("Resource_n207")])
example_text = "El caso de Sara: `fondo` era una copia, por eso `caja` siguió en 0."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el distrito ahora cuenta como acierto."
concept_text = "Paso por valor: la función recibe una copia; el original no cambia."

[resource]
script = ExtResource("5_mision")
id = &"RP-N2-01"
oa_code = "OA3.1"
title = "Repaso: Los Libros que no cuadran"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano"
variante_de = &"EJ-N2-01"
intro_dialogue = Array[String](["Antes de bajar, quiero estar seguro de algo.", "En el distrito fallaste algunas pruebas. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «Los Libros que no cuadran». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «Los Libros que no cuadran»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n208")
