[sub_resource type="Resource" id="Resource_n201"]
script = ExtResource("2_opt")
text = "`0`, porque `abonar` recibió una copia"
is_correct = true

[sub_resource type="Resource" id="Resource_n202"]
script = ExtResource("2_opt")
text = "`100`"
wrong_feedback = "La caja sigue vacía: los 100 se sumaron a una hoja que se borró al salir."
concept_on_error = "Con paso por valor la función modifica su copia, no el original."
hint = "Fíjate qué recibe `abonar`: un número suelto, no la placa de la caja."

[sub_resource type="Resource" id="Resource_n203"]
script = ExtResource("2_opt")
text = "Error de compilación"
wrong_feedback = "El programa compila y corre. El problema es adónde llega el cambio."
concept_on_error = "El código es válido; el original simplemente no cambia."
hint = "Corre sin errores. Sigue los 100: ¿en qué casilla quedaron?"

