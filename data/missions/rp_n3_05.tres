[sub_resource type="Resource" id="Resource_n301"]
script = ExtResource("2_opt")
text = "Se liberó solo"
wrong_feedback = "Soltar la placa no devuelve el bloque."
concept_on_error = "Solo `free` devuelve la memoria de `malloc`."
hint = "¿Alguien llamó a `free`?"

[sub_resource type="Resource" id="Resource_n302"]
script = ExtResource("2_opt")
text = "Error de compilación"
wrong_feedback = "El código compila y corre; el problema es lo que deja atrás."
concept_on_error = "Perder un puntero es válido en C, pero deja la memoria reservada."
hint = "Corre sin errores. ¿Qué queda reservado?"

[sub_resource type="Resource" id="Resource_n303"]
