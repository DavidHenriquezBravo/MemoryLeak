[sub_resource type="Resource" id="Resource_n308"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "int *q = malloc(sizeof(int));
*q = 8;
q = NULL;"
question = "¿Qué pasó con el bloque?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n304"), SubResource("Resource_n305")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "El 8 sigue reservado, pero nadie guarda ya su dirección: no se puede liberar."
example_code = "int *p = malloc(sizeof(int));
*p = 42;
p = NULL;"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n306"), SubResource("Resource_n307")])
example_text = "El origen del jefe: el 42 quedó reservado y sin placa."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el Núcleo ahora cuenta como acierto."
concept_text = "Fuga de memoria: memoria reservada sin referencia."

[resource]
script = ExtResource("5_mision")
id = &"RP-N3-05"
oa_code = "OA3.5"
title = "Repaso: El Origen del Jefe"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano, en la entrada del volcán"
variante_de = &"EJ-N3-05"
intro_dialogue = Array[String](["Antes de entrar al Núcleo, quiero estar seguro de algo.", "Fallaste algunas pruebas en la ciudad. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «El Origen del Jefe». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «El Origen del Jefe»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n308")
