objective = "→ Abre la casilla `0x002A`"
requires_mission = &"EJ-N1-03"
cell_address = "0x002A"
intro_dialogue = Array[String](["¡Mira! Al sacar el amuleto vi un cofre sellado en el fondo del estanque.", "Por fuera tiene grabado `0x002A`. Dicen que adentro hay {addr:0x002A} monedas de oro.", "Tu daga ya quedó enlazada a él: `int *p = &oro;`", "La etiqueta nos trajo hasta acá. Ahora hay que seguirla hacia adentro, con `*`."])
reminder_dialogue = Array[String](["El cofre sigue cerrado. Busca la casilla `0x002A` en el estanque."])
success_dialogue = Array[String](["¡{addr:0x002A} monedas! ¡Somos ricos!", "Bueno… tú más que yo. Toma tu parte."])
done_dialogue = Array[String](["Todavía no gasto ni una moneda del cofre."])
