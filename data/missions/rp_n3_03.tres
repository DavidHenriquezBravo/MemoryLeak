[sub_resource type="Resource" id="Resource_n314"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "int pociones[5] = {2, 4, 6, 8, 10};
int *p = pociones;
printf(\"%d\", *(p + 3));"
question = "¿Qué vale `*(p + 3)`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n304"), SubResource("Resource_n305"), SubResource("Resource_n306"), SubResource("Resource_n307"), SubResource("Resource_n308")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "`p + 3` avanza tres casillas desde el inicio y el `*` lee lo que hay ahí: `pociones[3]`."
example_code = "int armas[4] = {10, 20, 30, 40};
int *p = armas;
printf(\"%d\", *(p + 2));"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n309"), SubResource("Resource_n310"), SubResource("Resource_n311"), SubResource("Resource_n312"), SubResource("Resource_n313")])
example_text = "El arsenal del Armero: `*(p + 2)` es la tercera arma, 30."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el Núcleo ahora cuenta como acierto."
concept_text = "`*(p + i)` es lo mismo que `p[i]`."

[resource]
script = ExtResource("5_mision")
id = &"RP-N3-03"
oa_code = "OA3.4"
title = "Repaso: El Arsenal del Núcleo"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano, en la entrada del volcán"
variante_de = &"EJ-N3-03"
intro_dialogue = Array[String](["Antes de entrar al Núcleo, quiero estar seguro de algo.", "Fallaste algunas pruebas en la ciudad. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «El Arsenal del Núcleo». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «El Arsenal del Núcleo»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n314")
