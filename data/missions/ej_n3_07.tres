[sub_resource type="Resource" id="Resource_n313"]
script = ExtResource("4_ex")
title = "EL GOLPE"
code = "int a = 1, b = 2;
int *p = &a;
int **pp = &p;
*pp = &b;
*p = 9;
printf(\"%d %d\", a, b);"
question = "¿Qué imprime?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n305"), SubResource("Resource_n306"), SubResource("Resource_n307"), SubResource("Resource_n308")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "`pp` guarda la placa de `p`. `*pp = &b` escribe en `p`: la daga ahora apunta a `b`, y el golpe `*p = 9` cae sobre `b`."
example_code = "int a = 3, b = 6;
int *p = &a;
int **pp = &p;
*pp = &b;
*p = 1;   // a = 3, b = 1"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n309"), SubResource("Resource_n310"), SubResource("Resource_n311"), SubResource("Resource_n312")])
example_text = "La anomalía movió la daga a `b` antes del golpe: `a` queda en 3 y `b` en 1."
example_followup = "Mismo ritual, otros números. Vuelve con el Armero: ¿qué imprime su prueba?"
success_title = "¡GOLPE TRAZADO!"
success_text = "`*pp = &b` movió la daga; el golpe siguiente cayó sobre `b`."
concept_text = "Escribir en `*pp` cambia a dónde apunta `p`."
reward = SubResource("Resource_n304")

