[resource]
script = ExtResource("5_mision")
id = &"EJ-N3-07"
oa_code = "OA3.3 / OA3.4"
title = "La Daga que cambió de dueño"
objective = "→ Traza el golpe del Armero"
requires_all = Array[StringName]([&"EJ-N3-02", &"EJ-N3-03"])
giver_name = "el Armero"
intro_dialogue = Array[String](["Volviste. Quiero probar el filo de tu daga con el registro maestro del Archivista.", "La enlazo a un aldeano a través del registro: `int a = 1, b = 2; int *p = &a; int **pp = &p;`.", "Pero una anomalía reescribe el registro a mitad del ritual: `*pp = &b;`. Y recién después cae el golpe: `*p = 9;`.", "`pp` no toca a nadie: mueve la daga. Fíjate a quién apunta cuando cae el golpe."])
reminder_dialogue = Array[String](["Traza la daga línea por línea. ¿A quién apunta cuando cae el golpe?"])
success_dialogue = Array[String](["`*pp = &b` movió la daga, así que el golpe cayó sobre `b` y `a` quedó intacto.", "Tienes buen ojo. Te reforcé la armadura con lo que sobró del ritual."])
done_dialogue = Array[String](["La daga se mueve antes del golpe. Siempre mira dónde está cuando golpeas."])
locked_dialogue = Array[String](["Para esta prueba necesitas dos cosas: saber caminar mi arsenal y entender el servicio del Archivista.", "Vuelve cuando hayas hecho las dos."])
exercise = SubResource("Resource_n313")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n314")])
