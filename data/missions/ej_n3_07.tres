[sub_resource type="Resource" id="Resource_n301"]
script = ExtResource("2_opt")
text = "`9 2`"
wrong_feedback = "Trazaste el golpe con la daga en su posición inicial. Pero la anomalía la movió una línea antes."
concept_on_error = "`*pp = &b` escribe en `p`: desde ahí, `p` apunta a `b`."
hint = "Justo antes de `*p = 9`, ¿a quién apunta `p`?"

[sub_resource type="Resource" id="Resource_n302"]
script = ExtResource("2_opt")
text = "`1 9`"
is_correct = true

[sub_resource type="Resource" id="Resource_n303"]
script = ExtResource("2_opt")
text = "`9 9`"
wrong_feedback = "Una daga apunta a una sola casilla a la vez: el golpe cae en una, no en las dos."
concept_on_error = "`*p = 9` escribe solo en la casilla a la que apunta `p` en ese momento."
hint = "¿Puede `p` apuntar a dos casillas a la vez?"

