[resource]
script = ExtResource("5_mision")
id = &"EJ-N2-06"
oa_code = "OA1.3 / OA2.2"
title = "Los Yunques Desiguales"
objective = "→ Abre la pieza de Ref `0x0220`"
giver_name = "Cast y Ref"
cell_address = "0x0220"
intro_dialogue = Array[String](["Ahora que cada uno tiene su fuerza, discutimos por otra cosa.", "Yo mido mis piezas en enteros. Mi hermano las mide en decimales: `double pieza = 12.5;`.", "Cuando intento enlazar mi daga de enteros a su pieza, el mundo me escupe un error rojo.", "Mi pieza está junto a la tuya, pero ocupa el doble. La placa lo dice, y tu daga lo sabe. Está en {addr:0x0220}, entre las dos forjas."])
reminder_dialogue = Array[String](["La pieza de Ref está en `0x0220`, entre las forjas. Mira bien cuánto ocupa."])
success_dialogue = Array[String](["¡Una daga de doubles! Ahora el enlace no tiembla.", "Ref y yo te forjamos algo con ella. Corta más que cualquier cosa del distrito."])
done_dialogue = Array[String](["Daga de enteros para piezas enteras, daga de doubles para piezas dobles. Fácil, ¿no?"])
exercise = SubResource("Resource_n208")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n209")])
