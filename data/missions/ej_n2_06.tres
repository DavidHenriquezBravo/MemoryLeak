[sub_resource type="Resource" id="Resource_n201"]
script = ExtResource("2_opt")
text = "Porque no se puede aplicar `&` a un `double`"
wrong_feedback = "Sí se puede tomar la dirección de un `double`. El problema es la daga que la recibe."
concept_on_error = "`&` funciona con cualquier variable; da un puntero de su mismo tipo."
hint = "La placa de la pieza existe. Mira qué tipo de daga intenta sostenerla."

[sub_resource type="Resource" id="Resource_n202"]
script = ExtResource("2_opt")
text = "Porque `&pieza` es de tipo `double *` y `p` es `int *`: los tipos no coinciden"
is_correct = true

[sub_resource type="Resource" id="Resource_n203"]
script = ExtResource("2_opt")
text = "Porque falta inicializar `p`"
wrong_feedback = "`p` sí se inicializa en esa misma línea: el error rojo sale justo al enlazarla."
concept_on_error = "El problema no es la falta de valor, es que el tipo del valor no calza."
hint = "La daga sí recibe algo. ¿Calza lo que recibe con lo que es?"

[sub_resource type="Resource" id="Resource_n204"]
script = ExtResource("3_reward")
amount = 10.0

[sub_resource type="Resource" id="Resource_n208"]
script = ExtResource("4_ex")
title = "CASILLA DE MEMORIA"
code = "double pieza = 12.5;
int *p = &pieza;"
question = "¿Por qué es incorrecta la línea `int *p = &pieza;`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n205"), SubResource("Resource_n206")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "Un puntero sabe cuánto mide la casilla que apunta. Un `int *` espera casillas de `int`, no de `double`."
example_code = "float peso = 4.5;
int *p = &peso;    // error
float *q = &peso;  // bien"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n207")])
example_text = "`&peso` es `float *`. Para enlazarlo hace falta una daga del mismo tipo: `float *q`."
example_followup = "Mismo concepto, otra pieza. Vuelve con la pieza de Ref: ¿por qué falla el enlace?"
success_title = "¡ENLACE ESTABLE!"
success_text = "Cambias a una Daga de Doubles y el enlace se estabiliza."
concept_text = "El tipo del puntero debe coincidir con el de la variable: `double *p = &pieza;`."
reward = SubResource("Resource_n204")

