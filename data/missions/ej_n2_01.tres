[sub_resource type="Resource" id="Resource_n202"]
script = ExtResource("2_opt")
text = "`10`, porque la función abonó al fondo"
wrong_feedback = "Sara abre el buzón: sigue en cero. El oficio abonó a otra hoja, no a su caja."
concept_on_error = "Una función que recibe un `int` trabaja con una copia del valor."
hint = "Mira qué recibe la función: un `int`, no una placa. Lo que anotó no fue el libro de Sara."

[sub_resource type="Resource" id="Resource_n203"]
script = ExtResource("2_opt")
text = "`0`, porque `abonar` recibió una copia local que se destruyó al terminar"
is_correct = true

[sub_resource type="Resource" id="Resource_n204"]
script = ExtResource("2_opt")
text = "Error de compilación"
wrong_feedback = "El oficio corre sin quejarse: compila y se ejecuta. El problema no es de escritura, es de destino."
concept_on_error = "El programa es válido en C; lo que falla es adónde va el cambio."
hint = "El programa sí corre. Sigue el 10: ¿en qué casilla quedó escrito?"

[sub_resource type="Resource" id="Resource_n205"]
