[sub_resource type="Resource" id="Resource_n210"]
script = ExtResource("4_ex")
title = "CASILLA DE MEMORIA"
code = "void abonar(int fondo) {
    fondo = fondo + 10;
}
int caja = 0;
abonar(caja);
printf(\"%d\", caja);"
question = "¿Qué imprime este programa y por qué?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n206"), SubResource("Resource_n207")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n202"), SubResource("Resource_n203"), SubResource("Resource_n204")])
conceptual_hint = "Al llamar a la función se copia el valor de `caja`. Lo que la función cambie se queda en esa copia y desaparece al terminar."
example_code = "void abonar(int saldo) {
    saldo += 100;
}
int caja = 0;
abonar(caja);   // caja sigue en 0"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n208"), SubResource("Resource_n209")])
example_text = "`abonar` suma 100 a `saldo`, que es una copia. Al salir, la copia se borra y `caja` sigue en 0."
example_followup = "Mismo concepto, otro oficio. Vuelve al buzón: ¿qué imprime el programa de Sara?"
success_title = "¡FUGA DIAGNOSTICADA!"
success_text = "El oficio de Sara recibe una copia: abona a una hoja que se bota al salir."
concept_text = "Paso por valor: la función recibe una copia; el original no cambia."
reward = SubResource("Resource_n205")

