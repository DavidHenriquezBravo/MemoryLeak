label = "buzón del fondo de Sara"

[resource]
script = ExtResource("5_mision")
id = &"EJ-N2-01"
oa_code = "OA3.1"
title = "Los Libros que no cuadran"
objective = "→ Sigue la placa vieja del atril `0x0120`"
giver_name = "Sara"
cell_address = "0x0140"
cadena = Array[ExtResource("1_cell")]([SubResource("Resource_n201")])
intro_dialogue = Array[String](["¡Un lector! Perdona el desorden. Soy Sara, la escriba: llevo las cuentas del maná del distrito.", "Cada día abono diez al fondo común… y cada mañana el fondo amanece en cero.", "Anoto en una hoja que se deshace al cerrar el libro. Lo que escribo nunca llega al fondo real.", "El buzón que llené está donde apunta mi placa vieja, {addr:0x0120}. La dejé sobre el atril, al fondo a la derecha."])
reminder_dialogue = Array[String](["¿Ya seguiste mi placa vieja `0x0120`? Está sobre el atril y sabe dónde quedó el buzón del fondo."])
success_dialogue = Array[String](["Entonces el oficio nunca tocó mi caja… solo una hoja suelta que se borraba al salir.", "Diagnosticaste la fuga. Ahora hay que arreglarla: el Notario redacta los oficios del distrito.", "Toma, una ración de maná del fondo. Por fin sé adónde se iba."])
done_dialogue = Array[String](["El fondo sigue en cero hasta que el Notario corrija el oficio. Pero ya sé por qué."])
exercise = SubResource("Resource_n210")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n211")])
