[sub_resource type="Resource" id="Resource_n208"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "void abonar(______ s) {
    ______ += 100;
}
int caja = 0;
abonar(______);"
question = "¿Cómo corriges `abonar` para que el original cambie?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n204"), SubResource("Resource_n205")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "Hacen falta las tres piezas: recibir `int *`, llamar con `&` y escribir con `*`."
example_code = "void abonar(int *fondo) {
    *fondo = *fondo + 10;
}
abonar(&caja);"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n206"), SubResource("Resource_n207")])
example_text = "El contrato del Notario: recibe la placa, se llama con `&caja` y escribe con `*fondo`."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el distrito ahora cuenta como acierto."
concept_text = "Paso por referencia: `void f(int *p)`, `f(&x)` y dentro `*p`."

[resource]
script = ExtResource("5_mision")
id = &"RP-N2-02"
oa_code = "OA3.2"
title = "Repaso: El Contrato del Notario"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano"
variante_de = &"EJ-N2-02"
intro_dialogue = Array[String](["Antes de bajar, quiero estar seguro de algo.", "En el distrito fallaste algunas pruebas. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «El Contrato del Notario». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «El Contrato del Notario»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n208")
