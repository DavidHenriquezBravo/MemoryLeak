[sub_resource type="Resource" id="Resource_n201"]
script = ExtResource("2_opt")
text = "`void abonar(int s)` + `abonar(&caja)`"
wrong_feedback = "La puerta sigue recibiendo números y le entregas una placa: el compilador lo rechaza."
concept_on_error = "Si se llama con `&caja`, el parámetro tiene que ser `int *`."
hint = "La llamada ya entrega una placa. ¿La puerta del oficio sabe recibirla?"

[sub_resource type="Resource" id="Resource_n202"]
script = ExtResource("2_opt")
text = "`void abonar(int *s)` + `abonar(&caja)` y `*s += 100;`"
is_correct = true

[sub_resource type="Resource" id="Resource_n203"]
script = ExtResource("2_opt")
text = "`void abonar(int *s)` + `abonar(caja)`"
wrong_feedback = "La puerta espera una placa y le pasas el contenido de la caja. Tipos incompatibles."
concept_on_error = "Un `int *` se llena con una dirección: `abonar(&caja)`."
hint = "El oficio está bien declarado. Revisa qué le entregas al llamarlo."

