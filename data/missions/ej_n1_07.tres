[sub_resource type="Resource" id="Resource_af1wg"]
script = ExtResource("4_2qkj8")
title = "CASILLA DE MEMORIA"
code = "double cosecha = 12.5;"
question = "¿De qué tipo es la expresión `&cosecha`?"
memory_cells = Array[ExtResource("1_6xsae")]([SubResource("Resource_sojlr")])
options = Array[ExtResource("2_1qy3i")]([SubResource("Resource_f6cre"), SubResource("Resource_vhlmy"), SubResource("Resource_bg4b5")])
conceptual_hint = "`&` le agrega un `*` al tipo: si `x` es `T`, `&x` es `T *`."
example_code = "char inicial = 'R';
char *p = &inicial;"
example_cells = Array[ExtResource("1_6xsae")]([SubResource("Resource_1rxp2"), SubResource("Resource_lnq3g")])
example_text = "`inicial` es `char`, así que `&inicial` es `char *`: la placa lleva escrito el tipo."
example_followup = "Mismo concepto, otra variable. Vuelve al balde grande: ¿de qué tipo es `&cosecha`?"
success_title = "¡TIPO CORRECTO!"
success_text = "La placa dice «balde de tipo double». Tu daga de doubles la acepta."
concept_text = "Si `x` es de tipo `T`, `&x` es de tipo `T *`."
reward = SubResource("Resource_di7ts")

