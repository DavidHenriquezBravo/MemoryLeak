[resource]
script = ExtResource("5_d3s46")
id = &"EJ-N1-07"
oa_code = "OA1.3"
title = "El Balde Grande de Andrés"
objective = "→ Abre la casilla `0x0030`"
requires_mission = &"EJ-N1-01"
cell_address = "0x0030"
intro_dialogue = Array[String](["Gracias a ti el agua ya no se evapora. Pero la cosecha la guardo en otro balde, uno más grande.", "Ahí caben {addr:0x0030} litros: es un `double cosecha;`. Te ofrezco su placa, pero tu daga podría no aceptarla.", "No todas las placas caben en todas las dagas. La mía dice el lugar, sí, pero también de qué tamaño es lo que hay ahí.", "Una placa siempre lleva escrito el tipo del balde al que pertenece."])
reminder_dialogue = Array[String](["El balde grande está junto al granero, en la casilla `0x0030`."])
success_dialogue = Array[String](["¡{addr:0x0030} litros! La mejor cosecha en años.", "Llévate un poco. Quien come bien, aguanta más."])
done_dialogue = Array[String](["Con {addr:0x0030} litros tenemos para todo el invierno."])
exercise = SubResource("Resource_af1wg")
reveals = Array[ExtResource("1_6xsae")]([SubResource("Resource_lkvyi")])
