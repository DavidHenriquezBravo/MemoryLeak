[resource]
script = ExtResource("5_mision")
id = &"EJ-N2-08"
oa_code = "OA2.1"
title = "Los Dos Espejos"
objective = "→ Abre el frasco enlazado (`0x0340` o `0x0344`)"
requires_all = Array[StringName]([&"EJ-N2-01", &"EJ-N2-02", &"EJ-N2-03", &"EJ-N2-04", &"EJ-N2-05", &"EJ-N2-06", &"EJ-N2-07"])
giver_name = "la Vidente"
cell_address = "0x0340"
intro_dialogue = Array[String](["Ahora que el distrito te conoce, puedo pedirte esto.", "Encargué dos espejos videntes y me entregaron solo uno funcional. El pedido decía `int *p, q;`.", "Escribí el asterisco una sola vez, al principio… ¿no bastaba para ambos?", "Los dos frascos de la receta están en casillas contiguas, junto a los rieles. Solo uno quedó enlazado: encuéntralo."])
reminder_dialogue = Array[String](["Los frascos están junto a los rieles, en casillas contiguas. Solo uno refleja algo."])
success_dialogue = Array[String](["Un asterisco, un espejo. Ahora entiendo por qué el segundo nunca reflejó nada.", "Toma mi armadura de cristal. Abajo, en la oscuridad, te hará falta.", "El Anciano te busca. Dice que ya sabe dónde se esconde el que roba las placas."])
done_dialogue = Array[String](["Ya pedí el espejo nuevo: `int *p, *q;`. Esta vez, con dos asteriscos."])
locked_dialogue = Array[String](["Los espejos me hablan de ti, pero todavía no es tu momento.", "Ayuda primero a Sara, al Notario y a los gemelos. Cuando el distrito entero te conozca, vuelve."])
exercise = SubResource("Resource_n210")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n211")])
