[sub_resource type="Resource" id="Resource_n210"]
script = ExtResource("4_ex")
title = "CASILLA DE MEMORIA"
code = "int x = 9;
int *p, q;
p = &x;"
question = "En `int *p, q;`, ¿qué tipo tiene `q`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n205"), SubResource("Resource_n206"), SubResource("Resource_n207")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "El asterisco se pega al nombre, no al tipo. Para dos punteros hay que escribirlo dos veces."
example_code = "char *a, b;
// a es char *
// b es char"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n208"), SubResource("Resource_n209")])
example_text = "En `char *a, b;` solo `a` es puntero. `b` es un `char` común, sin flecha."
example_followup = "Mismo concepto, otro pedido. Vuelve a los frascos: ¿qué tipo tiene `q`?"
success_title = "¡ESPEJO ENTENDIDO!"
success_text = "El asterisco se pega al nombre, no al tipo. El pedido correcto era `int *p, *q;`."
concept_text = "`int *p, q;` declara un puntero y un entero; dos punteros son `int *p, *q;`."
reward = SubResource("Resource_n204")

