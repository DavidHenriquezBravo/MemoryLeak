[sub_resource type="Resource" id="Resource_n202"]
script = ExtResource("2_opt")
text = "`int *`, igual que `p`"
wrong_feedback = "Ese es exactamente el malentendido de la Vidente: un asterisco, un espejo."
concept_on_error = "En una declaración, el `*` se aplica solo al nombre que tiene al lado."
hint = "Mira el frasco de al lado: no apunta a ninguna parte."

[sub_resource type="Resource" id="Resource_n203"]
script = ExtResource("2_opt")
text = "Error de compilación"
wrong_feedback = "El pedido se entregó sin problemas: la línea compila. Solo que no hizo lo que la Vidente creía."
concept_on_error = "Declarar `int *p, q;` es válido: crea un puntero y un entero."
hint = "El herrero sí pudo fabricar el pedido. ¿Qué fabricó, exactamente?"

