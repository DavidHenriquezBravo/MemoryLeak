[sub_resource type="Resource" id="Resource_rsfic"]
script = ExtResource("2_wsmxp")
text = "`&contador`"
wrong_feedback = "Esa expresión sí tiene un balde detrás: `contador` vive en su casilla. Busca la que no ocupa lugar."
concept_on_error = "Toda variable tiene dirección."
hint = "El portón no se mueve: esa expresión sí tiene un balde detrás."

