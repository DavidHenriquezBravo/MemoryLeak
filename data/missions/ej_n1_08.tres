[sub_resource type="Resource" id="Resource_g3qos"]
script = ExtResource("4_q3q86")
title = "PRUEBA DE LA SALIDA"
code = "int contador = 3;
int arreglo[10];"
question = "¿Cuál expresión NO es válida en C?"
memory_cells = Array[ExtResource("1_wd5c2")]([SubResource("Resource_6xfo7"), SubResource("Resource_vfkno"), SubResource("Resource_pw87i"), SubResource("Resource_u2qkb")])
options = Array[ExtResource("2_wsmxp")]([SubResource("Resource_rsfic"), SubResource("Resource_24hrl"), SubResource("Resource_xyckq")])
conceptual_hint = "Un número suelto (un literal) no está guardado en ninguna casilla."
example_code = "int x = 3;
&x;         // válido
&(3 + 4);   // inválido"
example_cells = Array[ExtResource("1_wd5c2")]([SubResource("Resource_x2dil"), SubResource("Resource_cfqh2")])
example_text = "`x` vive en una casilla y tiene placa. `3 + 4` es un resultado suelto: no hay placa que tomar."
example_followup = "Mismo concepto, otra expresión. Vuelve con Rivera: ¿cuál expresión NO es válida?"
success_title = "¡EXPRESIÓN INVÁLIDA HALLADA!"
success_text = "Rivera abre el portón. Un literal no vive en una casilla con etiqueta: no hay placa que tomar."
concept_text = "`&` solo se aplica a lo que ocupa memoria: variables y elementos."
reward = SubResource("Resource_ccib7")

[resource]
script = ExtResource("5_u4h3a")
id = &"EJ-N1-08"
oa_code = "OA1.4"
title = "La Prueba de la Salida"
objective = "→ Supera la prueba de Rivera"
requires_mission = &"EJ-N1-06"
intro_dialogue = Array[String](["Soy Rivera, guardián de Nullville. Gracias a ti, ahora lo recuerdo.", "Antes de abrir el portón, una última prueba. Hallé tres expresiones entre los escombros del colapso.", "Una nunca pudo existir: intenta tomar la placa de algo que jamás tuvo balde.", "Solo lo que ocupa un lugar tiene un lugar que pedir."])
reminder_dialogue = Array[String](["¿Listo para la prueba? Solo lo que ocupa un lugar tiene un lugar que pedir."])
success_dialogue = Array[String](["El camino está abierto. Más allá empieza el Distrito de las Funciones.", "Si llegas, busca a mi hermano. Vive en {addr:0x03F0}."])
done_dialogue = Array[String](["El portón está abierto. Suerte allá afuera."])
exercise = SubResource("Resource_g3qos")
