[sub_resource type="Resource" id="Resource_n309"]
script = ExtResource("4_ex")
title = "LA DEVOLUCIÓN"
code = "int *p = malloc(sizeof(int));
*p = 42;
__________
p = NULL;"
question = "¿Qué corrige la fuga del ejercicio anterior?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n305"), SubResource("Resource_n306")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "Mientras `p` todavía guarda la dirección del bloque, `free(p)` lo devuelve. Después ya se puede soltar la placa."
example_code = "int *q = malloc(sizeof(int));
*q = 8;
free(q);    // primero se devuelve
q = NULL;   // después se suelta"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n307"), SubResource("Resource_n308")])
example_text = "`free(q)` devuelve el bloque mientras `q` aún sabe dónde está; recién después se suelta con `NULL`."
example_followup = "Mismo sello, otro bloque. Vuelve con el Alquimista: ¿qué corrige su fuga?"
success_title = "¡FUGA SELLADA!"
success_text = "`free` devuelve el bloque antes de perder la placa."
concept_text = "Para evitar fugas: `free(p);` antes de reasignar o perder `p`."
reward = SubResource("Resource_n304")

