[resource]
script = ExtResource("5_mision")
id = &"EJ-N3-06"
oa_code = "OA3.5"
title = "La Devolución"
objective = "→ Sella la fuga del Alquimista"
requires_mission = &"EJ-N3-05"
giver_name = "el Alquimista"
intro_dialogue = Array[String](["Ahora que sabes cómo nació la fuga, ayúdame a sellarla: hay que devolver el bloque antes de perder la placa.", "Devuelve primero. Suelta después. Nunca al revés."])
reminder_dialogue = Array[String](["¿Qué hay que hacer antes de soltar la placa?"])
success_dialogue = Array[String](["El bloque vuelve al pozo. Ese es el sello que vas a necesitar contra el jefe final.", "Toma también esta capa de cristal: aguanta golpes que vienen de direcciones inválidas."])
done_dialogue = Array[String](["Primero `free`, después `NULL`. En ese orden."])
locked_dialogue = Array[String](["Primero tienes que entender cómo nació la fuga.", "Deja que te muestre el origen del jefe."])
exercise = SubResource("Resource_n309")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n310")])
