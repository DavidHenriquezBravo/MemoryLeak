[sub_resource type="Resource" id="Resource_n301"]
script = ExtResource("2_opt")
text = "Reasignar `p` antes de ponerlo en `NULL`"
wrong_feedback = "Reasignar la placa la aleja del bloque igual que el `NULL`: el bloque sigue reservado."
concept_on_error = "Cambiar el puntero no libera la memoria; solo `free` la devuelve."
hint = "Moviste la placa otra vez. ¿Qué función devuelve el bloque?"

[sub_resource type="Resource" id="Resource_n302"]
script = ExtResource("2_opt")
text = "Nada; el sistema operativo lo resuelve solo"
wrong_feedback = "Mientras el programa corre, el bloque sigue ocupado. En el Núcleo, eso alimenta al jefe."
concept_on_error = "Un programa en C debe liberar con `free` lo que reserva con `malloc`."
hint = "Si nadie lo devuelve, ¿quién lo hace?"

[sub_resource type="Resource" id="Resource_n303"]
script = ExtResource("2_opt")
text = "Llamar `free(p);` antes de perder la referencia"
is_correct = true

