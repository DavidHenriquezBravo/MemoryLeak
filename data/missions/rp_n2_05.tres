[sub_resource type="Resource" id="Resource_n210"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "int oro = 3;
int *r = &oro, *s = &oro;
*s = 12;"
question = "¿Cuánto vale `*r`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n204"), SubResource("Resource_n205"), SubResource("Resource_n206")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "`r` y `s` guardan la misma placa. Lo que escribe uno lo lee el otro."
example_code = "int mana = 5;
int *p = &mana, *q = &mana;
*p = 20;   // *q vale 20"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n207"), SubResource("Resource_n208"), SubResource("Resource_n209")])
example_text = "Los libros de Sara: dos placas, un solo cofre."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el distrito ahora cuenta como acierto."
concept_text = "Aliasing: dos punteros a la misma casilla ven el mismo dato."

[resource]
script = ExtResource("5_mision")
id = &"RP-N2-05"
oa_code = "OA3.3"
title = "Repaso: Los Dos Libros de Sara"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano"
variante_de = &"EJ-N2-05"
intro_dialogue = Array[String](["Antes de bajar, quiero estar seguro de algo.", "En el distrito fallaste algunas pruebas. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «Los Dos Libros de Sara». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «Los Dos Libros de Sara»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n210")
