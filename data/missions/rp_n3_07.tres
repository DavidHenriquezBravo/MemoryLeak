[sub_resource type="Resource" id="Resource_n301"]
script = ExtResource("2_opt")
text = "`1 6`"
wrong_feedback = "Trazaste el golpe con la daga en su lugar inicial; la anomalía la movió antes."
concept_on_error = "`*pp = &b` hace que `p` apunte a `b`."
hint = "Justo antes de `*p = 1`, ¿a quién apunta `p`?"

[sub_resource type="Resource" id="Resource_n302"]
