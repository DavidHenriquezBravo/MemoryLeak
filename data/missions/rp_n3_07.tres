[sub_resource type="Resource" id="Resource_n312"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "int a = 3, b = 6;
int *p = &a;
int **pp = &p;
*pp = &b;
*p = 1;
printf(\"%d %d\", a, b);"
question = "¿Qué imprime?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n304"), SubResource("Resource_n305"), SubResource("Resource_n306"), SubResource("Resource_n307")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "`*pp = &b` mueve la daga a `b`; el golpe `*p = 1` cae sobre `b` y `a` queda en 3."
example_code = "int a = 1, b = 2;
int *p = &a;
int **pp = &p;
*pp = &b;
*p = 9;
printf(\"%d %d\", a, b);"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n308"), SubResource("Resource_n309"), SubResource("Resource_n310"), SubResource("Resource_n311")])
example_text = "La prueba del Armero: la daga se movió a `b` y quedó `1 9`."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el Núcleo ahora cuenta como acierto."
concept_text = "Escribir en `*pp` cambia a dónde apunta `p`."

[resource]
script = ExtResource("5_mision")
id = &"RP-N3-07"
oa_code = "OA3.3 / OA3.4"
title = "Repaso: La Daga que cambió de dueño"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano, en la entrada del volcán"
variante_de = &"EJ-N3-07"
intro_dialogue = Array[String](["Antes de entrar al Núcleo, quiero estar seguro de algo.", "Fallaste algunas pruebas en la ciudad. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «La Daga que cambió de dueño». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «La Daga que cambió de dueño»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n312")
