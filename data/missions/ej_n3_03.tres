[sub_resource type="Resource" id="Resource_n301"]
script = ExtResource("2_opt")
text = "`20`"
wrong_feedback = "`p + 2` avanza dos posiciones desde la primera, no desde la segunda. Cuenta desde cero."
concept_on_error = "`p` apunta a `armas[0]`; `p + 2` apunta a `armas[2]`."
hint = "La primera arma es la posición 0. ¿Cuál es la posición 2?"

[sub_resource type="Resource" id="Resource_n302"]
script = ExtResource("2_opt")
text = "La dirección del tercer elemento"
wrong_feedback = "Avanzaste, pero no entraste: `p + 2` es la dirección; el `*` de afuera abre la casilla."
concept_on_error = "`p + 2` es una dirección; `*(p + 2)` es el valor guardado ahí."
hint = "Fíjate en el asterisco que envuelve el paréntesis."

