[sub_resource type="Resource" id="Resource_n315"]
script = ExtResource("4_ex")
title = "EL ARSENAL"
code = "int armas[4] = {10, 20, 30, 40};
int *p = armas;
printf(\"%d\", *(p + 2));"
question = "¿Qué imprime `printf(\"%d\", *(p + 2));`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n305"), SubResource("Resource_n306"), SubResource("Resource_n307"), SubResource("Resource_n308"), SubResource("Resource_n309")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "`p + 2` avanza dos casillas de `int` desde el inicio y el `*` lee lo que hay ahí. Es lo mismo que `armas[2]`."
example_code = "int pociones[5] = {2, 4, 6, 8, 10};
int *p = pociones;
// *(p + 3) vale 8"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n310"), SubResource("Resource_n311"), SubResource("Resource_n312"), SubResource("Resource_n313"), SubResource("Resource_n314")])
example_text = "Desde el inicio, tres pasos: `p + 3` es la cuarta poción y el `*` la abre: 8."
example_followup = "Mismo arsenal, otro estante. Vuelve con el Armero: ¿qué imprime `*(p + 2)`?"
success_title = "¡ARMA RECUPERADA!"
success_text = "Desde el inicio, dos casillas, y adentro: `*(p + 2)` es la tercera arma."
concept_text = "Aritmética de punteros: `*(p + i)` es lo mismo que `p[i]`."
reward = SubResource("Resource_n304")

