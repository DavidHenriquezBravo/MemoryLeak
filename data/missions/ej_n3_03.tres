label = "tercera arma del arsenal"

[resource]
script = ExtResource("5_mision")
id = &"EJ-N3-03"
oa_code = "OA3.4"
title = "El Arsenal del Núcleo"
objective = "→ Saca la tercera arma del arsenal"
giver_name = "el Armero"
intro_dialogue = Array[String](["¿Vienes por armas? Soy el Armero. O lo que queda de él: el arsenal se fragmentó con el colapso.", "Las armas quedaron en una fila continua: `int armas[4] = {10, 20, 30, 40};`. Mi daga apunta al inicio: `int *p = armas;`.", "Necesito la tercera arma, pero el índice quedó corrupto: nada de corchetes.", "El nombre del arsenal ya es una dirección. No le pongas &: avanza desde él."])
reminder_dialogue = Array[String](["La tercera arma. Sin corchetes: avanza desde el inicio y entra."])
success_dialogue = Array[String](["Avanzaste dos casillas y entraste. Esa es la tercera.", "Llévatela: corta más que cualquier cosa de Nullville."])
done_dialogue = Array[String](["Desde el inicio, dos pasos, y adentro. Así se camina un arsenal."])
exercise = SubResource("Resource_n315")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n316")])
