[resource]
script = ExtResource("5_mision")
id = &"EJ-N2-04"
oa_code = "OA2.4"
title = "El Registro del Distrito"
objective = "→ Abre el archivo del distrito `0x0300`"
requires_mission = &"EJ-N2-02"
giver_name = "el Notario"
cell_address = "0x0310"
cadena = Array[ExtResource("1_cell")]([SubResource("Resource_n201")])
intro_dialogue = Array[String](["Ah, vuelves. Tengo otro asunto, y este es tuyo.", "Custodio el registro donde figura cada oficio del distrito. El tuyo quedó inscrito con el número equivocado: dice 77 y debería decir 99.", "Tengo la dirección del asiento: `int *ptr_id = &id_registro;`.", "Mi registro está donde apunta el archivo del distrito, {addr:0x0300}, frente a esta oficina.", "Escribe el número correcto directamente en el asiento. No en una minuta. En el asiento."])
reminder_dialogue = Array[String](["El archivo `0x0300` te dirá dónde está el asiento. Escribe en el asiento, no en una minuta."])
success_dialogue = Array[String](["Noventa y nueve. Sellado en el registro real, no en un borrador.", "Ese número te habilita el paso. Y toma esto: el distrito cuida a los suyos."])
done_dialogue = Array[String](["Tu asiento dice 99. Cualquiera que lea el registro verá lo mismo."])
exercise = SubResource("Resource_n210")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n211")])
