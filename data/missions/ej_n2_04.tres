amount = 20.0

[sub_resource type="Resource" id="Resource_n210"]
script = ExtResource("4_ex")
title = "CASILLA DE MEMORIA"
code = "int id_registro = 77;
int *ptr_id = &id_registro;
*ptr_id = 99;
printf(\"%d\", id_registro);"
question = "Tras ejecutar `*ptr_id = 99;`, ¿qué imprime `printf(\"%d\", id_registro);`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n206"), SubResource("Resource_n207")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n202"), SubResource("Resource_n203"), SubResource("Resource_n204")])
conceptual_hint = "Escribir en la casilla que apunta un puntero cambia esa casilla para todos los que la lean."
example_code = "int codigo = 10;
int *p = &codigo;
*p = 55;
// codigo vale 55"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n208"), SubResource("Resource_n209")])
example_text = "`*p = 55` escribe en la casilla de `codigo`. No hay copia: `codigo` pasa a valer 55."
example_followup = "Mismo concepto, otro asiento. Vuelve al registro: ¿qué imprime `id_registro`?"
success_title = "¡REGISTRO CORREGIDO!"
success_text = "Reescribiste la RAM real. El registro queda corregido y te habilita el paso."
concept_text = "`*p = v` escribe en la casilla apuntada: el original cambia."
reward = SubResource("Resource_n205")

[sub_resource type="Resource" id="Resource_n211"]
