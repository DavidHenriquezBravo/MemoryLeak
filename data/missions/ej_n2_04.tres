[sub_resource type="Resource" id="Resource_n204"]
script = ExtResource("2_opt")
text = "La dirección de `id_registro`"
wrong_feedback = "El registro no imprime placas: `id_registro` es el número del asiento, no su dirección."
concept_on_error = "`id_registro` es el valor; su dirección sería `&id_registro`."
hint = "Se imprime la variable, no su placa. ¿Qué número quedó escrito en ella?"

[sub_resource type="Resource" id="Resource_n205"]
script = ExtResource("3_reward")
