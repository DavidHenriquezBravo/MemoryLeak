[sub_resource type="Resource" id="Resource_n202"]
script = ExtResource("2_opt")
text = "`77`"
wrong_feedback = "El Notario revisa el asiento y lo encuentra corregido. Tú sigues creyendo que escribiste en una minuta."
concept_on_error = "El puntero no guarda una copia: escribir a través de él cambia el original."
hint = "Mira adónde apunta `ptr_id` y qué hace la tercera línea en esa casilla."

