[resource]
script = ExtResource("5_mision")
id = &"EJ-N3-04"
oa_code = "OA3.4"
title = "El Censo de Nullville"
objective = "→ Explícale a la Bibliotecaria qué guarda el censo"
giver_name = "la Bibliotecaria"
intro_dialogue = Array[String](["Silencio, por favor. Soy la Bibliotecaria del Censo: aquí se anota a cada habitante de la Realidad.", "El censo no guarda los nombres en una fila. Guarda una fila de placas, y cada una lleva al inicio de un nombre guardado en otra parte.", "Este es el censo de tu pueblo: `char *aldeanos[3] = {\"Andres\", \"Juan\", \"Rivera\"};`.", "Mis estanterías no contienen los libros. Contienen dónde está cada libro."])
reminder_dialogue = Array[String](["Dime qué es `aldeanos`. Mira bien qué guarda cada estantería."])
success_dialogue = Array[String](["El censo se reconstruye. Y mira… aquí hay una ficha con tu nombre.", "Está demasiado borrosa para leerla, pero existe. Llévate algo de suerte."])
done_dialogue = Array[String](["Cada estantería, una placa. Cada placa, un nombre completo."])
exercise = SubResource("Resource_n315")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n316")])
