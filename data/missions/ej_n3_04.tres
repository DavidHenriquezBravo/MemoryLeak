[sub_resource type="Resource" id="Resource_n315"]
script = ExtResource("4_ex")
title = "EL CENSO"
code = "char *aldeanos[3] = {
    \"Andres\",
    \"Juan\",
    \"Rivera\"
};"
question = "¿Qué es `aldeanos`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n305"), SubResource("Resource_n306"), SubResource("Resource_n307"), SubResource("Resource_n308"), SubResource("Resource_n309"), SubResource("Resource_n310")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "En `char *aldeanos[3]`, el `[3]` arma tres estanterías y el `char *` dice qué guarda cada una: la dirección del inicio de un nombre."
example_code = "char *lugares[2] = {
    \"Nullville\",
    \"Nucleo\"
};
// lugares[0]: inicio de \"Nullville\""
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n311"), SubResource("Resource_n312"), SubResource("Resource_n313"), SubResource("Resource_n314")])
example_text = "`lugares[0]` no es la letra 'N' ni una copia del texto: es la placa que lleva al inicio de \"Nullville\"."
example_followup = "Mismo censo, otros nombres. Vuelve con la Bibliotecaria: ¿qué es `aldeanos`?"
success_title = "¡CENSO RECONSTRUIDO!"
success_text = "Cada estantería del censo guarda una placa hacia un nombre completo."
concept_text = "`char *a[n]` es un arreglo de punteros: cada elemento apunta al inicio de una cadena."
reward = SubResource("Resource_n304")

