[sub_resource type="Resource" id="Resource_n208"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "int y = 2;
int *p = &y;
y = 15;"
question = "¿Qué vale `*p`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n204"), SubResource("Resource_n205")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "`*p` lee la casilla de `y` en el momento en que se usa, con lo que tenga ahora."
example_code = "int x = 3;
int *p = &x;
x = 9;   // *p vale 9"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n206"), SubResource("Resource_n207")])
example_text = "El espejo de la Vidente: no guardó un retrato, guardó dónde estabas."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el distrito ahora cuenta como acierto."
concept_text = "`*p` siempre lee el valor actual de la casilla apuntada."

[resource]
script = ExtResource("5_mision")
id = &"RP-N2-07"
oa_code = "OA2.4"
title = "Repaso: El Espejo de la Vidente"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano"
variante_de = &"EJ-N2-07"
intro_dialogue = Array[String](["Antes de bajar, quiero estar seguro de algo.", "En el distrito fallaste algunas pruebas. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «El Espejo de la Vidente». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «El Espejo de la Vidente»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n208")
