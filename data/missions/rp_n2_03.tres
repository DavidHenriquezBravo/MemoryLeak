[sub_resource type="Resource" id="Resource_n201"]
script = ExtResource("2_opt")
text = "`b = a;`"
wrong_feedback = "Moviste las placas dentro del oficio; las casillas de afuera no cambian."
concept_on_error = "Asignar punteros cambia adónde miran, no lo que hay en las casillas."
hint = "Hay que verter contenido, no cambiar placas."

[sub_resource type="Resource" id="Resource_n202"]
script = ExtResource("2_opt")
text = "`*b = *a;`"
is_correct = true

[sub_resource type="Resource" id="Resource_n203"]
script = ExtResource("2_opt")
text = "`&b = &a;`"
wrong_feedback = "La dirección de una variable no se puede reasignar: eso ni compila."
concept_on_error = "`&b` no es una casilla donde escribir."
hint = "Esa línea no compila. Piensa en el contenido de cada casilla."

