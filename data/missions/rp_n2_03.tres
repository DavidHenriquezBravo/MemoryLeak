[sub_resource type="Resource" id="Resource_n210"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "void trocar(int *a, int *b) {
    int t = *b;
    __________
    *a = t;
}"
question = "¿Qué línea falta?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n204"), SubResource("Resource_n205"), SubResource("Resource_n206"), SubResource("Resource_n207")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "Esta vez se guardó primero `*b`. Falta que la casilla de `b` reciba el contenido de la de `a`."
example_code = "void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n208"), SubResource("Resource_n209")])
example_text = "El ritual de los gemelos: contenido a contenido, `*a = *b`."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el distrito ahora cuenta como acierto."
concept_text = "Para intercambiar con punteros se escribe en `*a` y `*b`."

[resource]
script = ExtResource("5_mision")
id = &"RP-N2-03"
oa_code = "OA3.2"
title = "Repaso: Los Gemelos Intercambiados"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano"
variante_de = &"EJ-N2-03"
intro_dialogue = Array[String](["Antes de bajar, quiero estar seguro de algo.", "En el distrito fallaste algunas pruebas. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «Los Gemelos Intercambiados». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «Los Gemelos Intercambiados»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n210")
