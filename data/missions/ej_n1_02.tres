[sub_resource type="Resource" id="Resource_722ky"]
script = ExtResource("4_5uuef")
title = "PRUEBA DEL HERRERO"
code = "int *daga;"
question = "¿Qué es capaz de guardar `daga`?"
memory_cells = Array[ExtResource("1_h6b5w")]([SubResource("Resource_4kkbo"), SubResource("Resource_5hc57")])
options = Array[ExtResource("2_cm31c")]([SubResource("Resource_yuubh"), SubResource("Resource_b8sks"), SubResource("Resource_xofjo")])
conceptual_hint = "Todo tiene contenido (el 30) y lugar (su placa `0x0004`). La daga guarda lugares."
example_code = "int trigo = 5;
int *p = &trigo;"
example_cells = Array[ExtResource("1_h6b5w")]([SubResource("Resource_1c32t"), SubResource("Resource_8bfdh")])
example_text = "`p` no guarda un 5: guarda la placa `0x0010`, el lugar donde vive el 5."
example_followup = "Mismo concepto, otra variable. Vuelve a tu daga: `int *daga;` ¿qué puede guardar?"
success_title = "¡PUNTERO RECONOCIDO!"
success_text = "La daga sostiene placas, no contenidos."
concept_text = "`int *daga` guarda la dirección de un `int`."
reward = SubResource("Resource_pbcbx")

[resource]
script = ExtResource("5_y2b4q")
id = &"EJ-N1-02"
oa_code = "OA2.1"
title = "La Daga que forjó Juan"
objective = "→ Muéstrale la daga a Juan"
intro_dialogue = Array[String](["Mira la inscripción del mango: `int *daga;`. La hoja está hueca a propósito: no corta, sostiene."])
success_dialogue = Array[String](["Exacto. Déjame afilarla un poco… Así sostiene mejor."])
done_dialogue = Array[String](["La daga ya sostiene bien. ¡Gracias por tu ayuda!"])
exercise = SubResource("Resource_722ky")
