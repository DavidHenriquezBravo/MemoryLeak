text = "`q = 0;`"
wrong_feedback = "Eso pierde la placa igual que `NULL`: el bloque sigue reservado."
concept_on_error = "Cambiar el puntero no libera la memoria."
hint = "¿Qué función devuelve el bloque?"

[sub_resource type="Resource" id="Resource_n303"]
script = ExtResource("2_opt")
text = "Nada"
wrong_feedback = "Sin `free`, el bloque queda ocupado: es una fuga."
concept_on_error = "Lo que se reserva con `malloc` se devuelve con `free`."
hint = "¿Quién devuelve el bloque si no lo haces tú?"

