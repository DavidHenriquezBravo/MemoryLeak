[sub_resource type="Resource" id="Resource_n310"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "void mover(______ p, char *nuevo) {
    *p = nuevo;
}"
question = "Para que una función reasigne tu puntero `char *`, ¿qué recibe?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n304"), SubResource("Resource_n305"), SubResource("Resource_n306")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "Para cambiar algo desde una función se recibe su dirección. La dirección de un `char *` es un `char **`."
example_code = "void reasignar(int **daga, int *nuevo) {
    *daga = nuevo;
}
reasignar(&p, &otro);"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n307"), SubResource("Resource_n308"), SubResource("Resource_n309")])
example_text = "El servicio del Archivista: recibe `int **`, la placa de tu daga, y la mueve a `otro`."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el Núcleo ahora cuenta como acierto."
concept_text = "Para reasignar un puntero en una función, el parámetro es un puntero a puntero."

[resource]
script = ExtResource("5_mision")
id = &"RP-N3-02"
oa_code = "OA3.4"
title = "Repaso: El Servicio de Reasignación"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano, en la entrada del volcán"
variante_de = &"EJ-N3-02"
intro_dialogue = Array[String](["Antes de entrar al Núcleo, quiero estar seguro de algo.", "Fallaste algunas pruebas en la ciudad. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «El Servicio de Reasignación». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «El Servicio de Reasignación»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n310")
