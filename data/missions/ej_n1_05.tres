[sub_resource type="Resource" id="Resource_0solo"]
script = ExtResource("4_svd1u")
title = "CASILLA DE MEMORIA"
code = "int cerradura = 1;
int *ptr = &cerradura;"
question = "¿Cuál línea deja `cerradura` en 0?"
memory_cells = Array[ExtResource("1_mqygn")]([SubResource("Resource_6bsti"), SubResource("Resource_p0s5u")])
options = Array[ExtResource("2_l2bts")]([SubResource("Resource_oamdh"), SubResource("Resource_udvd7"), SubResource("Resource_bkktc")])
conceptual_hint = "`*` viaja a la dirección guardada y trabaja sobre lo que hay allí."
example_code = "int vida = 10;
int *p = &vida;
*p = 0;"
example_cells = Array[ExtResource("1_mqygn")]([SubResource("Resource_qjrqd"), SubResource("Resource_vx5vf")])
example_text = "`*p = 0` viaja a la placa `0x0010` y escribe 0 en `vida`."
example_followup = "Mismo concepto, otra variable. Vuelve a tu candado: ¿qué línea escribe en `cerradura`?"
success_title = "¡ESCRITURA POR REFERENCIA!"
success_text = "El candado cede. Juan entra a su taller y te forja una mejora de daño."
concept_text = "`*ptr = 0` escribe en la variable original, no en una copia."
reward = SubResource("Resource_d2a3i")

