text = "`int **p`, porque para modificar el puntero se necesita su dirección"
is_correct = true

[sub_resource type="Resource" id="Resource_n303"]
script = ExtResource("2_opt")
text = "`int p`"
wrong_feedback = "Con un `int` suelto la función recibe una copia de un número: ni el cofre ni la daga se enteran."
concept_on_error = "Paso por valor: la función trabaja con una copia."
hint = "Un número suelto no lleva a ninguna parte. Necesitas una placa."

