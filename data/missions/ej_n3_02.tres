[sub_resource type="Resource" id="Resource_n301"]
script = ExtResource("2_opt")
text = "`int *p`"
wrong_feedback = "Con `int *p` puedes cambiar el balde, no la daga. La daga de afuera sigue igual."
concept_on_error = "Para cambiar una variable desde una función se recibe su dirección; la dirección de un `int *` es un `int **`."
hint = "¿Qué quieres cambiar: el cofre o la daga? Recibe la placa de eso."

[sub_resource type="Resource" id="Resource_n302"]
