label = "tu daga, reasignada"

[resource]
script = ExtResource("5_mision")
id = &"EJ-N3-02"
oa_code = "OA3.4"
title = "El Servicio de Reasignación"
objective = "→ Dile al Archivista qué debe recibir su servicio"
requires_mission = &"EJ-N3-01"
giver_name = "el Archivista"
intro_dialogue = Array[String](["Tengo otro servicio: muevo tu daga a otro cofre sin que tengas que soltarla.", "Pero no opero a ciegas. No quiero saber a dónde apuntas. Quiero saber dónde estás tú.", "Para cambiar el contenido de un balde recibo su placa. Para cambiar una daga… recibo la placa de la daga."])
reminder_dialogue = Array[String](["Dime qué tiene que recibir mi servicio para mover tu daga."])
success_dialogue = Array[String](["Exacto: la placa de la daga. Misma regla de siempre, un nivel más arriba.", "Mientras operaba te reasigné algo de vitalidad. No me lo agradezcas."])
done_dialogue = Array[String](["Para mover una daga, me das dónde está la daga. Nunca lo olvides."])
locked_dialogue = Array[String](["El registro maestro primero, viajero.", "Recorre mi cadena de custodia antes de pedirme servicios."])
exercise = SubResource("Resource_n311")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n312")])
