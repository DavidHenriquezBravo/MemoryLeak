[sub_resource type="Resource" id="Resource_n311"]
script = ExtResource("4_ex")
title = "SERVICIO DE REASIGNACIÓN"
code = "void reasignar(______ daga, int *nuevo) {
    *daga = nuevo;
}
int cofre = 7, otro = 9;
int *p = &cofre;
reasignar(&p, &otro);"
question = "Para que una función haga que tu puntero apunte a otra variable, ¿qué parámetro debe recibir?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n305"), SubResource("Resource_n306"), SubResource("Resource_n307")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "Para cambiar algo desde una función, la función recibe su dirección. Si lo que cambias es un `int *`, su dirección es un `int **`."
example_code = "void mover(char **p, char *nuevo) {
    *p = nuevo;
}
char a = 'x', b = 'y';
char *letra = &a;
mover(&letra, &b);   // letra apunta a b"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n308"), SubResource("Resource_n309"), SubResource("Resource_n310")])
example_text = "Para reasignar un `char *`, la función recibe un `char **`: la placa de la daga. Con `*p = nuevo`, la daga de afuera cambia de cofre."
example_followup = "Mismo servicio, otra daga. Vuelve con el Archivista: ¿qué parámetro debe recibir?"
success_title = "¡DAGA REASIGNADA!"
success_text = "Para mover un puntero desde una función, se le entrega la dirección del puntero."
concept_text = "Para cambiar un `int *` dentro de una función, el parámetro es `int **`."
reward = SubResource("Resource_n304")

