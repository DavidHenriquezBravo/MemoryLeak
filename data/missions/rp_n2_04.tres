[sub_resource type="Resource" id="Resource_n208"]
script = ExtResource("4_ex")
title = "REPASO DEL ANCIANO"
code = "int codigo = 10;
int *p = &codigo;
*p = 55;
printf(\"%d\", codigo);"
question = "¿Qué imprime `codigo`?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n204"), SubResource("Resource_n205")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n201"), SubResource("Resource_n202"), SubResource("Resource_n203")])
conceptual_hint = "`p` mira la casilla de `codigo`. Lo que se escriba con `*p` lo verá cualquiera que lea `codigo`."
example_code = "int id_registro = 77;
int *ptr_id = &id_registro;
*ptr_id = 99;   // id_registro = 99"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n206"), SubResource("Resource_n207")])
example_text = "El registro del Notario: `*ptr_id = 99` cambió el asiento real."
example_followup = "Es el mismo concepto del caso original. Vuelve al repaso."
success_title = "¡REPASO SUPERADO!"
success_text = "Lo que fallaste en el distrito ahora cuenta como acierto."
concept_text = "`*p = v` escribe en la casilla apuntada: el original cambia."

[resource]
script = ExtResource("5_mision")
id = &"RP-N2-04"
oa_code = "OA2.4"
title = "Repaso: El Registro del Distrito"
objective = "→ Responde el repaso del Anciano"
giver_name = "el Anciano"
variante_de = &"EJ-N2-04"
intro_dialogue = Array[String](["Antes de bajar, quiero estar seguro de algo.", "En el distrito fallaste algunas pruebas. Para enfrentar al jefe hay que acertar al menos 7 de cada 10 al primer intento.", "Repasemos lo de «El Registro del Distrito». Te pondré un caso parecido: respóndelo con calma."])
reminder_dialogue = Array[String](["Sigamos con el repaso de «El Registro del Distrito»."])
success_dialogue = Array[String](["Bien. Eso ya no te lo van a quitar."])
done_dialogue = Array[String](["Ese caso ya lo dominas."])
exercise = SubResource("Resource_n208")
