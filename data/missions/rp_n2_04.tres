wrong_feedback = "La casilla de `codigo` ya dice 55: `*p` escribió en ella."
concept_on_error = "Escribir a través del puntero cambia el original."
hint = "La tercera línea escribe en la casilla apuntada. ¿Cuál es?"

[sub_resource type="Resource" id="Resource_n202"]
script = ExtResource("2_opt")
text = "Su dirección"
wrong_feedback = "Se imprime la variable, no su placa."
concept_on_error = "`codigo` es el valor; su dirección sería `&codigo`."
hint = "No hay `&` en el printf. ¿Qué número tiene la casilla?"

