[resource]
script = ExtResource("5_44jpc")
id = &"EJ-N1-03"
oa_code = "OA2.2"
title = "El Amuleto de Vicente"
objective = "→ Abre la casilla `0x0018`"
cell_address = "0x0018"
intro_dialogue = Array[String](["¡Oye, oye! ¡Ayúdame! Se me cayó mi {addr:0x0018} de la suerte al estanque.", "Cada vez que meto la mano saco un duplicado falso… ¡y se deshace en el agua!", "No puedo agarrarlo. Necesito que tu daga apunte a mi {addr:0x0018}, no que lo copie. Pídeme la dirección con `&`."])
reminder_dialogue = Array[String](["Mi {addr:0x0018} sigue en el agua… La casilla `0x0018` está en la orilla."])
success_dialogue = Array[String](["¡Mi {addr:0x0018}! ¡El de verdad! Este no se deshace.", "Toma este trébol, venía enredado en la cuerda. Dicen que da suerte."])
done_dialogue = Array[String](["¡Mi {addr:0x0018} me trae suerte desde que lo recuperaste!"])
exercise = SubResource("Resource_smdsh")
reveals = Array[ExtResource("1_yc18u")]([SubResource("Resource_mved3")])
