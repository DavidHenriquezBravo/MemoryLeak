[sub_resource type="Resource" id="Resource_smdsh"]
script = ExtResource("4_ni84o")
title = "CASILLA DE MEMORIA"
code = "int amuleto = 15;"
question = "¿Cuál declaración enlaza correctamente la daga al amuleto?"
memory_cells = Array[ExtResource("1_yc18u")]([SubResource("Resource_h5b4o"), SubResource("Resource_pomti")])
options = Array[ExtResource("2_hpy7g")]([SubResource("Resource_4088s"), SubResource("Resource_3x606"), SubResource("Resource_03rut")])
conceptual_hint = "Enlazar pide dos cosas: que sea daga (`*` al declarar) y que reciba una placa (`&`)."
example_code = "int antidoto = 8;
int *q = &antidoto;"
example_cells = Array[ExtResource("1_yc18u")]([SubResource("Resource_x8ohl"), SubResource("Resource_dck72")])
example_text = "`&antidoto` entrega la placa `0x0010` y `q` la guarda: la daga queda enlazada."
example_followup = "Mismo concepto, otra variable. Vuelve a tu casilla: ¿cuál declaración enlaza la daga al amuleto?"
success_title = "¡DAGA ENLAZADA!"
success_text = "La daga queda enlazada al amuleto real. Vicente lo saca del estanque."
concept_text = "Enlazar un puntero: `int *p = &variable;`"
reward = SubResource("Resource_8mjwd")

[sub_resource type="Resource" id="Resource_mved3"]
