text = "`int p = &amuleto;`"
wrong_feedback = "Guardaste la placa en un balde común. Sin el `*` no es una daga: no puede seguirla."
concept_on_error = "Para guardar una dirección, la variable debe ser puntero (`int *`)."
hint = "Vicente saca otro {addr:0x0018} falso: la daga recibió un 15, no un lugar."

