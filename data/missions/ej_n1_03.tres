[sub_resource type="Resource" id="Resource_4088s"]
script = ExtResource("2_hpy7g")
text = "`int *p = amuleto;`"
wrong_feedback = "Le entregaste el contenido a la daga en vez de la placa. La daga no sabe dónde está el {addr:0x0018}."
concept_on_error = "Sin `&`, el puntero recibe el valor (15), no la dirección."
hint = "Vicente saca otro {addr:0x0018} falso: la daga recibió un 15, no un lugar."

[sub_resource type="Resource" id="Resource_3x606"]
