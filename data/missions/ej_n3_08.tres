[sub_resource type="Resource" id="Resource_n313"]
script = ExtResource("4_ex")
title = "LAS DOS FICHAS"
code = "int a = 7, b = 7;
int *p = &a, *q = &b;
printf(\"%d %d\", a == b, p == q);"
question = "¿Qué imprime?"
memory_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n305"), SubResource("Resource_n306"), SubResource("Resource_n307"), SubResource("Resource_n308")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_n301"), SubResource("Resource_n302"), SubResource("Resource_n303")])
conceptual_hint = "`a == b` compara lo que dicen las fichas; `p == q` compara dónde están. En C, verdadero se imprime como 1 y falso como 0."
example_code = "int x = 5, y = 5;
int *p = &x, *q = &y;
// x == y vale 1, p == q vale 0"
example_cells = Array[ExtResource("1_cell")]([SubResource("Resource_n309"), SubResource("Resource_n310"), SubResource("Resource_n311"), SubResource("Resource_n312")])
example_text = "`x` e `y` valen lo mismo, pero viven en casillas distintas: `x == y` da 1 y `p == q` da 0."
example_followup = "Mismas fichas, otros números. Vuelve con la Bibliotecaria: ¿qué imprime su comparación?"
success_title = "¡FICHAS SEPARADAS!"
success_text = "Mismo valor, distinta dirección: `a == b` es 1 y `p == q` es 0."
concept_text = "Comparar valores no es comparar direcciones."
reward = SubResource("Resource_n304")

