[resource]
script = ExtResource("5_mision")
id = &"EJ-N3-08"
oa_code = "OA1.1 / OA3.4"
title = "Las Dos Fichas Idénticas"
objective = "→ Demuestra que iguales no es lo mismo"
requires_mission = &"EJ-N3-04"
giver_name = "la Bibliotecaria"
intro_dialogue = Array[String](["Tengo un problema en el censo. Dos aldeanos tienen exactamente la misma edad y exigen figurar como una sola ficha.", "`int a = 7, b = 7; int *p = &a, *q = &b;` Demuéstrales que ser iguales no es ser el mismo.", "Dos fichas pueden decir lo mismo y estar guardadas en estanterías distintas."])
reminder_dialogue = Array[String](["¿Qué imprime la comparación? Una compara lo que dicen las fichas; la otra, dónde están."])
success_dialogue = Array[String](["Valores iguales, direcciones distintas. El censo conserva las dos fichas.", "Los aldeanos se van conformes. Te ganaste un poco de suerte."])
done_dialogue = Array[String](["Iguales por dentro, distintos por fuera. Así se queda el censo."])
locked_dialogue = Array[String](["Primero ayúdame a reconstruir el censo.", "Después hablamos de las fichas repetidas."])
exercise = SubResource("Resource_n313")
reveals = Array[ExtResource("1_cell")]([SubResource("Resource_n314")])
