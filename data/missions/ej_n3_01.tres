[sub_resource type="Resource" id="Resource_n301"]
script = ExtResource("2_opt")
text = "La dirección de `p`"
wrong_feedback = "Te quedaste parado frente al cajón: eso es lo que guarda `pp` sin abrirlo."
concept_on_error = "Cada `*` es un salto. `pp` guarda la dirección de `p`; `**pp` llega hasta `vida`."
hint = "Cuenta los asteriscos del printf: cada uno abre un cajón."

[sub_resource type="Resource" id="Resource_n302"]
script = ExtResource("2_opt")
text = "La dirección de `vida`"
wrong_feedback = "Un solo salto te deja en la daga intermedia: ahí está la dirección de `vida`. Necesitas seguir saltando."
concept_on_error = "`*pp` es `p`, una dirección; `**pp` es lo que hay en esa dirección."
hint = "Diste un salto. ¿Cuántos asteriscos tiene `**pp`?"

