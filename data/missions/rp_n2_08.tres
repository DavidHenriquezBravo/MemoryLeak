[sub_resource type="Resource" id="Resource_n201"]
script = ExtResource("2_opt")
text = "`char *`"
wrong_feedback = "Un asterisco, un puntero: `b` quedó como `char` común."
concept_on_error = "El `*` se aplica solo al nombre que tiene al lado."
hint = "¿A qué nombre está pegado el asterisco?"

