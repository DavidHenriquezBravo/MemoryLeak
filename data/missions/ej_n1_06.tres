[sub_resource type="Resource" id="Resource_jluyb"]
script = ExtResource("4_1qt53")
title = "CASILLA DE MEMORIA"
code = "int *mente = NULL;"
question = "¿Qué significa que un puntero valga `NULL`?"
memory_cells = Array[ExtResource("1_x67h8")]([SubResource("Resource_p3u13"), SubResource("Resource_nqn6o")])
options = Array[ExtResource("2_o6l8q")]([SubResource("Resource_0dvap"), SubResource("Resource_ylruo"), SubResource("Resource_npd7p")])
conceptual_hint = "Un puntero en `NULL` no apunta a ninguna casilla. Usar `*` sobre él rompe el programa."
example_code = "int *p = NULL;
if (p != NULL) {
    *p = 5;
}"
example_cells = Array[ExtResource("1_x67h8")]([SubResource("Resource_b7v8a")])
example_text = "`p` vale `NULL`: no apunta a ninguna casilla. Por eso se comprueba antes de usar `*`."
example_followup = "Mismo concepto, otra variable. Vuelve con Rivera: ¿qué significa que un puntero valga `NULL`?"
success_title = "¡PELIGRO EVITADO!"
success_text = "Entendiste el peligro. Rivera baja la lanza: no lo obligaste a seguir una placa vacía."
concept_text = "`NULL` = sin destino válido. Compruébalo antes de usar `*`."
reward = SubResource("Resource_nysog")

