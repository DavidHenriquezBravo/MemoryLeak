[sub_resource type="Resource" id="Resource_ylruo"]
script = ExtResource("2_o6l8q")
text = "Que apunta a la dirección 0, que es válida y usable"
wrong_feedback = "Empujaste a Rivera a seguir una placa en blanco. El mundo parpadea: eso es un Segmentation Fault."
concept_on_error = "`NULL` no es una dirección usable: desreferenciarlo rompe el programa."
hint = "Rivera tiembla: seguir esa placa lo haría caer al vacío."

