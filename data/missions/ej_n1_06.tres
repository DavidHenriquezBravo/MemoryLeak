wrong_feedback = "Rivera busca un espacio en blanco en su mente y no encuentra nada: no hay casilla que leer."
concept_on_error = "`NULL` no es un valor guardado: es la ausencia de destino."
hint = "Rivera tiembla: seguir esa placa lo haría caer al vacío."

