[resource]
script = ExtResource("5_iwcqt")
id = &"EJ-N1-06"
oa_code = "OA2.5"
title = "El Nombre del Guardia"
objective = "→ Abre la casilla `0x00FF`"
cell_address = "0x00FF"
intro_dialogue = Array[String](["Alto ahí. Nadie cruza la salida de la aldea.", "Mi placa dice que me llamo {addr:0x00FF}… pero no logro recordarlo. Mi registro quedó en la garita.", "Mi mente es un puntero sin asignar: apunta a `NULL`.", "Y sé que si intento seguir esta placa vacía, algo terrible pasará."])
reminder_dialogue = Array[String](["Sigo sin recordar mi nombre. Mi registro está en la casilla `0x00FF`, en la garita."])
success_dialogue = Array[String](["{addr:0x00FF}. Me llamo {addr:0x00FF}. ¡Ahora lo recuerdo!", "Gracias, viajero. Toma mi escudo de repuesto. Vuelve cuando estés listo para salir."])
done_dialogue = Array[String](["Soy {addr:0x00FF}, guardián de Nullville. Gracias otra vez."])
exercise = SubResource("Resource_jluyb")
reveals = Array[ExtResource("1_x67h8")]([SubResource("Resource_1v33d")])
